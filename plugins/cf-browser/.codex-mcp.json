{
  "mcpServers": {
    "cf_browser": {
      "command": "node",
      "args": [
        "./server/launch.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "CF_ACCOUNT_ID",
        "CF_API_TOKEN",
        "CFB_DEFAULT_PROFILE",
        "CFB_IDLE_TIMEOUT_S",
        "CFB_OPEN_LIVE_VIEW",
        "CFB_HOME"
      ],
      "startup_timeout_sec": 30
    }
  }
}
